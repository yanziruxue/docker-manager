{
  "name": "docker-stack-manager",
  "version": "1.38.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently -n server,vite -c blue,green \"tsx server/index.ts\" \"vite --host --port 8088\"",
    "build": "vite build && tsc -p server/tsconfig.json",
    "lint:hooks": "node scripts/check-hooks.mjs",
    "lint:notify": "node scripts/check-notify-wiring.mjs",
    "test:secrets": "tsx scripts/check-secrets.ts",
    "test:logs": "tsx scripts/check-log-channels.ts",
    "test:auth": "node scripts/check-auth-render.mjs && node scripts/check-auth-wiring.mjs",
    "test:restart": "node scripts/check-restart-wait.mjs",
    "test:thermal": "node scripts/check-thermal.mjs",
    "test:install": "bash scripts/check-install-drivetemp.sh",
    "test:gates": "npm run lint:hooks && npm run lint:notify && npm run test:secrets && npm run test:logs && npm run test:auth && npm run test:restart && npm run test:thermal && npm run test:install",
    "build:frontend": "node scripts/check-hooks.mjs && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:binary": "vite build && node scripts/build-binary.mjs",
    "build:linux": "bash deploy/linux/build.sh",
    "build:bundle": "cmd /c deploy\\linux\\build-bundle.cmd",
    "release": "node scripts/publish-release.mjs",
    "publish": "bash scripts/publish.sh",
    "start": "node server/dist/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.453.0",
    "nodemailer": "^10.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "ws": "^8.21.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
