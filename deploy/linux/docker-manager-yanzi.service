[Unit]
Description=Docker Manager Yanzi — 多引擎 Docker 管理面板
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=docker-manager-yanzi
Group=docker-manager-yanzi
# 允许访问 Docker socket（docker 组权限）
SupplementaryGroups=docker
# 进程 cwd 即安装目录，数据/日志/配置分别保存在 data/ logs/ config/ 子目录
WorkingDirectory=/opt/docker-manager-yanzi
Environment=NODE_ENV=production
# 固定 PATH：确保 spawnSync 能找到 docker / docker-compose（与 root shell 一致）
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# docker CLI 配置隔离：ProtectHome=yes 会屏蔽 /home 下的 ~/.docker，
# 指向安装目录内可写目录，避免 "Error loading config file: permission denied" 干扰 compose 检测
Environment="DOCKER_CONFIG=/opt/docker-manager-yanzi/config/docker-cli"

# 内核 DMI sysfs 中 product_serial / product_uuid / board_serial 的权限是 0400（仅 root 可读），
# 非 root 服务读不到，会让「本机设备标识」卡片这几行显示「—」。
# 启动前以 root（"+" 前缀：提权执行且绕过沙箱）把 DMI 值镜像成世界可读的小文件到 RuntimeDirectory，
# 供卡片展示（仅展示用途，不参与 6 维硬件指纹）。刻意不写 $VAR：systemd 会先做变量展开。
RuntimeDirectory=docker-manager-yanzi
ExecStartPre=+/bin/sh -c 'cat /sys/class/dmi/id/board_name > /run/docker-manager-yanzi/dmi-board_name 2>/dev/null; cat /sys/class/dmi/id/product_serial > /run/docker-manager-yanzi/dmi-product_serial 2>/dev/null; cat /sys/class/dmi/id/product_uuid > /run/docker-manager-yanzi/dmi-product_uuid 2>/dev/null; true'

ExecStart=/opt/docker-manager-yanzi/docker-manager-yanzi
Restart=always
RestartSec=5

# 安全加固
# 注意：必须关闭 NoNewPrivileges，否则 sudo（setuid）会被 no_new_privs 拦截，
# 导致「镜像加速源 → 写入 /etc/docker/daemon.json / 重启 docker」无法提权执行。
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# /var/run 通常是 /run 的符号链接，同时声明两条路径避免挂载隔离后找不到可写目标
# 安装目录整体可写：在线升级需要替换安装目录下的二进制文件（mv 覆盖，无需 root）
# /etc/docker 可写：设置页需要读写 daemon.json 的 registry-mirrors（配合 sudo 提权）
ReadWritePaths=/opt/docker-manager-yanzi /run/docker.sock /var/run/docker.sock /etc/docker

# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
